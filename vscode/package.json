{
  "name": "codeactor",
  "displayName": "CodeActor",
  "description": "AI coding assistant powered by Claude",
  "version": "0.0.1",
  "publisher": "codeactor",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeactor/codeactor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:codeactorView",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:csharp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:swift"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeactor",
          "title": "CodeActor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeactor": [
        {
          "id": "codeactorView",
          "type": "webview",
          "name": "CodeActor"
        }
      ]
    },
    "commands": [
      {
        "command": "codeactor.executeCodeLensCommand",
        "title": "CodeActor: Execute CodeLens Command"
      },
      {
        "command": "codeactor.editCodeLensConfig",
        "title": "CodeActor: Edit CodeLens Commands"
      }
    ],
    "configuration": {
      "title": "CodeActor",
      "properties": {
        "codeactor.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens buttons above functions and classes."
        },
        "codeactor.codeLensCommands": {
          "type": "array",
          "description": "List of CodeLens commands shown above each code definition.",
          "items": {
            "type": "object",
            "required": [
              "title",
              "action",
              "messageTemplate"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "Button label shown in the editor."
              },
              "tooltip": {
                "type": "string",
                "description": "Hover tooltip for the button."
              },
              "action": {
                "type": "string",
                "description": "Action identifier (e.g. explain, review). Use 'edit' to suppress a lens."
              },
              "messageTemplate": {
                "type": "string",
                "description": "Message template sent to Claude. Use {code} as a placeholder for the selected code."
              }
            }
          },
          "default": [
            {
              "title": "⚡ Explain",
              "tooltip": "Explain this code",
              "action": "explain",
              "messageTemplate": "Explain the following code:\n\n{code}"
            },
            {
              "title": "🔍 Review",
              "tooltip": "Review for bugs and improvements",
              "action": "review",
              "messageTemplate": "Review the following code for bugs and improvements:\n\n{code}"
            }
          ]
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.codeactor-protocol.json",
        "url": "./protocol/agent-events.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle -- --production && npm run copy-wasm",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "compile": "tsc -p ./ --noEmit",
    "watch": "npm run bundle:watch",
    "copy-webui": "node scripts/copy-webui.js",
    "copy-wasm": "node scripts/copy-wasm.js",
    "build": "npm run copy-webui && npm run bundle -- --production && npm run copy-wasm && vsce package --no-yarn --no-git-tag-version",
    "postinstall": "cd ../webui && npm install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "glob": "^10.3.10",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  }
}
